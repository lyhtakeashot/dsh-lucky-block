# 依赖与构建产物
node_modules/
pnpm-lock.yaml
package-lock.json
npm-shrinkwrap.json

# 调研资料（从 DSH 安装包里解出来的第三方源码，重新分发不合适）
# 这个目录已经删了（42 MB，全是子代理解包产物）。
# 手写的考据笔记与语料候选文件归档在 docs/research-notes/，那个是要提交的。
research/

# 本机专用的排查笔记（含绝对路径）
docs/PRD.md
docs/探针流程.md

# 探针运行时产物
docs/.probe-token
docs/*.log
docs/*.log.err
# git commit -F 用的临时信息文件（PowerShell 的 here-string 传中文会被当路径解析，
# 只能先落盘再 -F；忘了删就会被 git add -A 一起提交，踩过一次）
docs/.commitmsg.txt
docs/.commit-msg.txt
docs/commit-msg.txt
docs/cm.txt
.commitmsg.txt
.commit-msg.txt
commit-msg.txt
cm.txt

# 抓音频时的中间文件（B 站源文件几十 MB，不进仓库）
# 用通配符而不是逐个列：每次换歌都会多出几个，列漏了就会把 20 MB 的 m4a 提交进去
docs/.*-src.m4a

# docs/ 下所有点前缀的临时文件：探针输出、token、抓取中间文本、一次性脚本。
# 过去是一条条往这里加，加漏一次就会 `git add -A` 进仓库（踩过好几回）。
# docs/ 只该有 .md 和 research-notes/，其余都算草稿。
docs/.*

# 抓 B 站音频 / 找高潮的一次性工具（点前缀 = 不进 npm 包）
tools/.fetch-bv.mjs
tools/.loudest.mjs
tools/.find-audio.mjs
tools/.check-bv.mjs
tools/.search-bv.mjs

# 编辑器 / 系统
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*~
.commitmsg.txt
